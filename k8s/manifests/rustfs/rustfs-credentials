#!/usr/bin/env python3
"""AWS CLI credential_process for RustFS STS, backed by a Kubernetes SA token.

Mints a short-lived ServiceAccount token, exchanges it for RustFS STS
credentials via AssumeRoleWithWebIdentity, and prints the JSON the AWS SDKs
expect. The CLI re-runs this whenever the credentials expire.
"""
import json
import os
import subprocess
import sys
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET

ENDPOINT = os.environ.get("RUSTFS_ENDPOINT", "https://s4.o.cavnet.cloud")
NAMESPACE = os.environ.get("RUSTFS_SA_NAMESPACE", "rustfs")
SA = os.environ.get("RUSTFS_SA", "admin")
AUDIENCE = os.environ.get("RUSTFS_AUDIENCE", "rustfs")
TOKEN_TTL = os.environ.get("RUSTFS_TOKEN_TTL", "10m")
KUBECTL = os.environ.get("KUBECTL", "kubectl")


def die(message: str) -> None:
    print(f"rustfs credential_process: {message}", file=sys.stderr)
    sys.exit(1)


def service_account_token() -> str:
    try:
        return subprocess.run(
            [KUBECTL, "create", "token", SA, "-n", NAMESPACE,
             "--audience", AUDIENCE, "--duration", TOKEN_TTL],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
    except FileNotFoundError:
        die(f"{KUBECTL} not found on PATH")
    except subprocess.CalledProcessError as err:
        die(f"kubectl create token failed: {err.stderr.strip()}")


def assume_role(token: str) -> dict[str, str]:
    body = urllib.parse.urlencode({
        "Action": "AssumeRoleWithWebIdentity",
        "Version": "2011-06-15",
        "WebIdentityToken": token,
    }).encode()
    request = urllib.request.Request(
        ENDPOINT.rstrip("/") + "/", data=body,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
    )
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            payload = response.read()
    except urllib.error.HTTPError as err:
        die(f"STS returned HTTP {err.code}: {err.read().decode(errors='replace').strip()}")
    except OSError as err:
        die(f"could not reach {ENDPOINT}: {err}")

    values = {e.tag.rsplit("}", 1)[-1]: (e.text or "") for e in ET.fromstring(payload).iter()}
    missing = [f for f in ("AccessKeyId", "SecretAccessKey", "SessionToken", "Expiration")
               if not values.get(f)]
    if missing:
        die(f"STS response missing {', '.join(missing)}")
    return values


def main() -> None:
    creds = assume_role(service_account_token())
    json.dump({
        "Version": 1,
        "AccessKeyId": creds["AccessKeyId"],
        "SecretAccessKey": creds["SecretAccessKey"],
        "SessionToken": creds["SessionToken"],
        "Expiration": creds["Expiration"],
    }, sys.stdout)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
