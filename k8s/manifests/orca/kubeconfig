apiVersion: v1
kind: Config
clusters:
  - name: talos-prod
    cluster:
      server: https://kubernetes.default.svc
      certificate-authority: /var/run/secrets/orca/kubernetes/ca.crt
users:
  # client-go re-reads tokenFile, so the kubelet's rotations reach running sessions.
  - name: orca
    user:
      tokenFile: /var/run/secrets/orca/kubernetes/token
contexts:
  - name: talos-prod
    context:
      cluster: talos-prod
      user: orca
      namespace: orca
current-context: talos-prod
