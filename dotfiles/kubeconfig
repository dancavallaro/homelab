kind: Config
apiVersion: v1
clusters:
  - name: talos-prod
    cluster:
      server: https://k8s.cavnet.cloud:6443
      certificate-authority-data: 
users:
  - name: oidc@talos-prod
    user:
      exec:
        command: kubectl
        args:
          - oidc-login
          - get-token
          - --oidc-issuer-url=https://pocket-id.o.cavnet.cloud
          - --oidc-client-id=816acb21-3d87-470c-8d90-8c17ee9da65c
          - --oidc-extra-scope=email,groups
        env: null
        apiVersion: client.authentication.k8s.io/v1
        provideClusterInfo: false
        interactiveMode: Always
contexts:
  - name: talos-prod-oidc
    context:
      cluster: talos-prod
      user: oidc@talos-prod
      namespace: default
current-context: talos-prod-oidc
