logging {
  level  = "info"
  format = "logfmt"
}

livedebugging {
  enabled = true
}

spiffe.x509_source "agent" {
  address = "unix:///var/run/spirl/spiffe.sock"
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "https://mimir.o.cavnet.cloud/api/v1/push"
    spiffe {
      source     = spiffe.x509_source.agent.source
      server_ids = ["spiffe://prod.cavallaro.local/talos-prod/ns/monitoring/sa/mimir"]
    }
  }
}

prometheus.exporter.unix "default" {
  set_collectors = [
    "boottime", "cpu", "diskstats", "filefd", "filesystem", "loadavg", "meminfo",
    "netclass", "netdev", "netstat", "processes", "stat", "time", "vmstat",
  ]
  netdev {
    device_exclude = "^ovs-system$"
  }
  netclass {
    ignored_devices = "^ovs-system$"
  }
  filesystem {
    // Alloy's defaults plus tmpfs and efivarfs
    fs_types_exclude = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|efivarfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs|tmpfs)$"
  }
}

prometheus.scrape "hostmetrics" {
  scrape_interval = "60s"
  targets         = prometheus.exporter.unix.default.targets
  forward_to      = [prometheus.relabel.hostmetrics.receiver]
}

prometheus.relabel "hostmetrics" {
  rule {
    action        = "replace"
    source_labels = ["instance"]
    target_label  = "host"
  }
  rule {
    action       = "replace"
    replacement  = "host_metrics"
    target_label = "service"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}

loki.write "loki" {
  endpoint {
    url = "https://loki.o.cavnet.cloud/loki/api/v1/push"
    spiffe {
      source     = spiffe.x509_source.agent.source
      server_ids = ["spiffe://prod.cavallaro.local/talos-prod/ns/monitoring/sa/loki"]
    }
  }
}

loki.relabel "syslog" {
  // Rules export only: __syslog_* labels don't reach components later in the chain
  forward_to = []

  rule {
    action        = "replace"
    source_labels = ["__syslog_message_hostname"]
    target_label  = "host"
  }
  rule {
    action        = "replace"
    source_labels = ["__syslog_message_severity"]
    target_label  = "level"
  }
  rule {
    action        = "replace"
    source_labels = ["__syslog_message_app_name"]
    target_label  = "application"
  }
  rule {
    action        = "replace"
    source_labels = ["__syslog_message_facility"]
    target_label  = "facility"
  }
}

loki.source.syslog "local" {
  listener {
    address  = "127.0.0.1:1514"
    protocol = "tcp"
    labels   = {service_name = "host.syslog"}
    // Long idle timeout to avoid timeout log noise during quiet periods
    idle_timeout = "24h"
  }
  relabel_rules = loki.relabel.syslog.rules
  forward_to    = [loki.write.loki.receiver]
}
