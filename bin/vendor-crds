#!/usr/bin/env bash
set -euo pipefail

# Dumps the cluster's CRDs to a local directory for IntelliJ's Kubernetes plugin
# (Settings | Languages & Frameworks | Kubernetes | Custom Resource Definitions).

OUT_DIR=${1:-$(git rev-parse --show-toplevel)/.crds}

mkdir -p "$OUT_DIR"
# Full rebuild so CRDs uninstalled since the last run don't linger as stale schemas.
rm -f "$OUT_DIR"/*.yaml

for crd in $(kubectl get crd -o jsonpath='{.items[*].metadata.name}'); do
  kubectl get crd "$crd" -o yaml \
    | yq 'del(.status, .metadata.annotations."kubectl.kubernetes.io/last-applied-configuration",
               .metadata.creationTimestamp, .metadata.generation, .metadata.resourceVersion,
               .metadata.uid, .metadata.managedFields)' \
    > "$OUT_DIR/$crd.yaml"
done

echo "Vendored $(ls -1 "$OUT_DIR"/*.yaml | wc -l | tr -d ' ') CRDs from $(kubectl config current-context) to $OUT_DIR"
